(function () {
  const side    = document.getElementById("sidebar");
  const overlay = document.getElementById("overlay");
  const menu    = document.getElementById("menu");
  const closeBtn= document.getElementById("sidebar-close");

  function open() {
    if (!side) return;
    side.classList.add("open");
    if (overlay) overlay.classList.add("show");
    document.body.style.overflow = "hidden";
  }
  function close() {
    if (!side) return;
    side.classList.remove("open");
    if (overlay) overlay.classList.remove("show");
    document.body.style.overflow = "";
  }
  function toggle() {
    if (!side) return;
    side.classList.contains("open") ? close() : open();
  }

  if (menu)     menu.addEventListener("click", toggle);
  if (overlay)  overlay.addEventListener("click", close);
  if (closeBtn) closeBtn.addEventListener("click", close);
  document.addEventListener("keydown", e => { if (e.key === "Escape") close(); });

  // Auto-close on nav click (mobile only)
  document.querySelectorAll(".sidebar .sb-nav a").forEach(a => {
    const href = a.getAttribute("href") || "";
    if (href && href !== "#" && !href.startsWith("javascript")) {
      a.addEventListener("click", () => {
        if (window.matchMedia("(max-width: 900px)").matches) close();
      });
    }
  });

  /* ─────────── Collapsible groups ─────────── */
  const GROUPS = document.querySelectorAll(".sb-group");
  const STORAGE_KEY = "rdm-sidebar-groups";

  function getStored() {
    try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; }
    catch (e) { return {}; }
  }
  function saveStored(obj) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(obj)); }
    catch (e) {}
  }

  const path = location.pathname;
  const stored = getStored();

  // Determine which group contains the current path
  // Pick the LONGEST matching data-path
  function findActiveGroup() {
    let activeGroup = null;
    let bestLen = 0;
    GROUPS.forEach(g => {
      g.querySelectorAll("a[data-path]").forEach(a => {
        const p = a.dataset.path;
        const exact = a.dataset.exact === "1";
        const matches = exact
          ? path === p
          : (path === p || path.startsWith(p + "/") || path.startsWith(p + "?"));
        if (matches && p.length > bestLen) {
          bestLen = p.length;
          activeGroup = g;
        }
      });
    });
    return activeGroup;
  }

  const activeGroup = findActiveGroup();

  GROUPS.forEach(g => {
    const name = g.dataset.group;
    const storedState = stored[name];
    let shouldOpen;
    if (storedState === true)      shouldOpen = true;
    else if (storedState === false) shouldOpen = false;
    else if (activeGroup === g)    shouldOpen = true;
    else if (name === "workspace") shouldOpen = true;
    else                           shouldOpen = false;

    if (shouldOpen) g.classList.add("open");

    const head = g.querySelector(".sb-group-head");
    if (head) {
      head.addEventListener("click", () => {
        const now = !g.classList.contains("open");
        g.classList.toggle("open", now);
        const cur = getStored();
        cur[name] = now;
        saveStored(cur);
      });
    }
  });

  /* ─────────── Active-link detection ─────────── */
  // Longest-prefix-match wins
  const allLinks = [...document.querySelectorAll('.sb-nav a[data-path]')];
  allLinks.sort((a, b) => b.dataset.path.length - a.dataset.path.length);

  let winner = null;
  for (const a of allLinks) {
    const p = a.dataset.path;
    const exact = a.dataset.exact === "1";
    const matches = exact
      ? path === p
      : (path === p || path.startsWith(p + "/") || path.startsWith(p + "?"));
    if (matches) { winner = a; break; }
  }
  if (winner) winner.classList.add("active");
})();
